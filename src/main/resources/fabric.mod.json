{
	"schemaVersion": 1,
	"id": "seven-elements",
	"version": "\u0024{version}",
	"name": "Seven Elements",
	"description": "A Minecraft mod that brings a faithful implementation of Genshin Impact's Elemental Combat system in Minecraft",
	"authors": [
		"_xRickAstley"
	],
	"contact": {
		"homepage": "https://xrickastley.github.io/SevenElements/wiki/",
		"sources": "https://github.com/xrickastley/SevenElements",
		"issues": "https://github.com/xrickastley/SevenElements/issues"
	},
	"license": "ARR",
	"icon": "assets/seven-elements/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.xrickastley.sevenelements.SevenElements"
		],
		"client": [
			"io.github.xrickastley.sevenelements.SevenElementsClient"
		],
		"modmenu": [
			"io.github.xrickastley.sevenelements.SevenElementsModMenu"
		],
		"cardinal-components": [
			"io.github.xrickastley.sevenelements.SevenElementsCCAComponents"
		]
	},
	"accessWidener": "seven-elements.classtweaker",
	"mixins": [
		"seven-elements.mixins.json",
		"seven-elements.mixins.compat.json",
		{
			"config": "seven-elements.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~26.1",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": "*"	
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/world/BossEvent": [
				"io/github/xrickastley/sevenelements/interfaces/IBossBar"
			],
			"net/minecraft/world/damagesource/DamageSource": [
				"io/github/xrickastley/sevenelements/interfaces/IDamageSource"
			],
			"net/minecraft/world/effect/MobEffect": [
				"io/github/xrickastley/sevenelements/interfaces/EntityAwareEffect"
			],
			"net/minecraft/world/entity/Entity": [
				"io/github/xrickastley/sevenelements/interfaces/IEntity"
			],
			"net/minecraft/world/entity/LivingEntity": [
				"io/github/xrickastley/sevenelements/interfaces/ILivingEntity"
			],
			"net/minecraft/world/entity/projectile/Projectile": [
				"io/github/xrickastley/sevenelements/interfaces/InfusableProjectile"
			],
			"net/minecraft/world/item/ItemStack": [
				"io/github/xrickastley/sevenelements/interfaces/IItemStack"
			],
			"net/minecraft/client/gui/GuiGraphicsExtractor": [
				"io/github/xrickastley/sevenelements/interfaces/ExtendedGuiGraphicsExtractor"
			],
			"net/minecraft/client/renderer/SubmitNodeStorage\u0024ItemSubmit": [
				"io/github/xrickastley/sevenelements/interfaces/ElementGlintState"
			],
			"net/minecraft/client/renderer/SubmitNodeStorage\u0024ModelPartSubmit": [
				"io/github/xrickastley/sevenelements/interfaces/DataAttachmentAccess"
			],
			"net/minecraft/client/renderer/entity/state/LivingEntityRenderState": [
				"io/github/xrickastley/sevenelements/interfaces/SevenElementsLivingEntityRenderState"
			],
			"net/minecraft/client/renderer/item/ItemStackRenderState\u0024FoilType": [
				"io/github/xrickastley/sevenelements/interfaces/ElementGlintState"
			],
			"net/minecraft/client/renderer/item/ItemStackRenderState\u0024LayerRenderState": [
				"io/github/xrickastley/sevenelements/interfaces/ElementGlintState"
			]
		},
		"cardinal-components": [
			"seven-elements:elements",
			"seven-elements:elemental_infusion",
			"seven-elements:frozen_effect"
		]
	}
}